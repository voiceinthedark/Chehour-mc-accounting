{
  "name": "Chehour-mc-accounting-root",
  "version": "1.0.0",
  "description": "Monorepo root for Chehour-mc-accounting",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/web-display/*"
  ],
  "private": true,
  "packageManager": "npm@9.6.7",
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "backend:dev": "npm run dev -w apps/backend",
    "web:dev": "npm run dev -w apps/web-display"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.1.0",
    "sass-embedded": "^1.96.0",
    "turbo": "^2.6.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/montserrat": "^5.2.8",
    "@fontsource-variable/roboto": "^5.2.9",
    "@fontsource/almarai": "^5.2.8",
    "@fontsource/scheherazade-new": "^5.2.8",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.561.0",
    "prop-types": "^15.8.1",
    "react-hot-toast": "^2.6.0",
    "react-router": "^7.11.0",
    "react-router-dom": "^7.11.0"
  }
}

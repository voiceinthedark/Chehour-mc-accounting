datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENTITIES & SERVICES
// ==========================================

model Doctor {
  id            String  @id @default(uuid())
  name          String
  perPatientFee Decimal @db.Decimal(10, 2)
  perVisitFee   Decimal @db.Decimal(10, 2)

  tallies MonthlyTally[]
}

model Service {
  id                 String  @id @default(uuid())
  name               String
  price              Decimal @db.Decimal(10, 2)
  doctorSplitPercent Decimal @db.Decimal(3, 2)

  logs MonthlyServiceLog[]
}

// ==========================================
// 2. MONTHLY OPERATIONS (The Core)
// ==========================================

// Tracks the total aggregated activity for ONE doctor for ONE month
model MonthlyTally {
  id       String @id @default(uuid())
  doctorId String
  month    Int // 1 - 12
  year     Int // e.g., 2026

  // Aggregated Volumes
  totalVisits     Int @default(0) // Days the doctor actually showed up
  regularPatients Int @default(0) // Patients who paid
  charityPatients Int @default(0) // Patients covered by the center

  isPaidOut Boolean @default(false)

  doctor      Doctor              @relation(fields: [doctorId], references: [id])
  serviceLogs MonthlyServiceLog[]

  @@unique([doctorId, month, year]) // Prevents double-entry for the same month
}

// Tracks the total procedures (EKG/Echo) performed by the doctor that month
model MonthlyServiceLog {
  id        String @id @default(uuid())
  tallyId   String
  serviceId String

  regularCount Int @default(0)
  charityCount Int @default(0)

  tally   MonthlyTally @relation(fields: [tallyId], references: [id], onDelete: Cascade)
  service Service      @relation(fields: [serviceId], references: [id])
}

// ==========================================
// 3. SIMPLIFIED FINANCIAL LEDGER
// ==========================================

enum Category {
  PATIENT_FEE
  SERVICE_FEE
  DOCTOR_PAYOUT
  LAB_COST
  LAB_REVENUE
  CHARITY_EXPENSE
  GENERAL_EXPENSE
}

model LedgerTransaction {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  amount      Decimal  @db.Decimal(10, 2)
  isOutflow   Boolean
  category    Category
  description String
}

// ==========================================
// 4. LAB WORK (Bloodwork, external samples)
// ==========================================

// The Center collects the sample, sends it to a dedicated lab,
// and charges the patient 1.4x the amount owed to the lab.
model LabOrder {
  id           String   @id @default(uuid())
  date         DateTime @default(now())
  patientName  String?
  testName     String
  labCost      Decimal  @db.Decimal(10, 2) // amount owed to the external lab
  centerCharge Decimal  @db.Decimal(10, 2) // amount charged to the patient (labCost * 1.4)
  isSettled    Boolean  @default(false) // true once ledger entries are recorded
}
